{
  "title": "Campus Connect Monitoring",
  "panels": [
    {
      "title": "Prometheus HTTP Requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "prometheus_http_requests_total"
        }
      ]
    },
    {
      "title": "Campus Connect Availability",
      "type": "timeseries",
      "targets": [
        {
          "expr": "probe_success{job=\"campus-connect\"}"
        }
      ]
    }
  ],
  "schemaVersion": 39
}
